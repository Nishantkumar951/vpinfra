---
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;
---

<Layout 
  title={`${frontmatter.title} | V.P. Infra Blog`}
  description={frontmatter.excerpt}
>
  <article class="blog-post">
    <!-- Header -->
    <header class="blog-header text-center">
      <div class="container">
        <span class="blog-date fade-in-up">{new Date(frontmatter.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        <h1 class="fade-in-up mt-2">{frontmatter.title}</h1>
        {frontmatter.author && <p class="blog-author fade-in-up mt-4">By {frontmatter.author}</p>}
      </div>
    </header>

    <!-- Featured Image -->
    {frontmatter.image && (
      <div class="container text-center mt-8">
        <img src={frontmatter.image} alt={frontmatter.title} class="featured-image fade-in-up" />
      </div>
    )}

    <!-- Content -->
    <div class="container mt-8">
      <div class="blog-content fade-in-up">
        <slot />
      </div>
    </div>
  </article>
</Layout>

<style>
  .blog-header {
    background-color: var(--bg-gray);
    padding: 6rem 0 4rem;
    border-bottom: 1px solid #E2E8F0;
  }
  .blog-header h1 {
    font-size: 3rem;
    color: var(--secondary);
    max-width: 800px;
    margin: 0 auto;
  }
  .blog-date {
    font-size: 0.9rem;
    color: var(--primary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    display: inline-block;
  }
  .blog-author {
    color: var(--text-gray);
    font-style: italic;
  }
  .featured-image {
    max-width: 100%;
    height: auto;
    max-height: 500px;
    object-fit: cover;
    border-radius: 8px;
    box-shadow: var(--shadow-lg);
  }
  .blog-content {
    max-width: 800px;
    margin: 0 auto;
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-dark);
    padding-bottom: 5rem;
  }
  
  /* Global styles for markdown content inside .blog-content */
  :global(.blog-content h2) {
    font-size: 2rem;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    color: var(--secondary);
  }
  :global(.blog-content h3) {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--secondary);
  }
  :global(.blog-content p) {
    margin-bottom: 1.5rem;
  }
  :global(.blog-content ul), :global(.blog-content ol) {
    margin-bottom: 1.5rem;
    padding-left: 2rem;
  }
  :global(.blog-content li) {
    margin-bottom: 0.5rem;
  }
  :global(.blog-content blockquote) {
    border-left: 4px solid var(--primary);
    padding-left: 1.5rem;
    margin-left: 0;
    font-style: italic;
    color: var(--text-gray);
  }
</style>
