---
import Layout from './Layout.astro';

interface Props {
  title: string;
  seoTitle: string;
  description: string;
  tag: string;
  date: string;
  readTime: string;
  author: string;
  image: string;
  imageAlt: string;
  breadcrumb: string;
}

const { title, seoTitle, description, tag, date, readTime, author, image, imageAlt, breadcrumb } = Astro.props;
---

<Layout title={seoTitle} description={description}>

  <!-- Reading Progress Bar -->
  <div class="reading-progress" id="readingProgress" aria-hidden="true"></div>

  <!-- ── Post Header ─────────────────────────────────────────── -->
  <section class="post-header">
    <div class="post-header-bg" aria-hidden="true"></div>
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-sep">›</span>
        <a href="/blog/">Blog</a>
        <span class="breadcrumb-sep">›</span>
        <span>{breadcrumb}</span>
      </nav>
      <div class="post-header-inner">
        <div class="meta-tag-pill">{tag}</div>
        <h1 class="post-title fade-in-up">{title}</h1>
        <div class="post-meta fade-in-up">
          <span class="meta-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            {date}
          </span>
          <span class="meta-dot">·</span>
          <span class="meta-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            {readTime}
          </span>
          <span class="meta-dot">·</span>
          <span class="meta-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            {author}
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Article Body ────────────────────────────────────────── -->
  <section class="post-section">
    <div class="container">
      <div class="post-layout">

        <!-- Main Content -->
        <main class="post-main" id="articleContent">

          <!-- Hero Image -->
          <div class="post-hero-image-wrapper">
            <img src={image} alt={imageAlt} class="post-hero-image" loading="eager" />
            <div class="hero-image-overlay" aria-hidden="true"></div>
          </div>

          <!-- Article Body -->
          <article class="article-body" id="articleBody">
            <slot />
          </article>

          <!-- Author Card -->
          <div class="author-card">
            <div class="author-avatar" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div class="author-info">
              <p class="author-name">{author}</p>
              <p class="author-desc">VP Infra's engineering team writes about construction best practices, material standards, and project management insights from real residential and commercial projects across Lucknow and Uttar Pradesh.</p>
            </div>
          </div>

          <!-- Share + Back row -->
          <div class="post-footer-row">
            <a href="/blog/" class="back-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
              Back to Blog
            </a>
            <div class="share-row">
              <span class="share-label">Share:</span>
              <a href="https://wa.me/?text=Check%20this%20out%3A%20https%3A%2F%2Fvpinfra.co.in%2Fblog%2Fbest-house-builders-in-lucknow%2F" target="_blank" rel="noopener" class="share-btn share-wa" aria-label="Share on WhatsApp">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16z" opacity=".3"/><path d="M12.04 2C6.474 2 2 6.474 2 12.04c0 1.973.573 3.818 1.563 5.37L2 22l4.703-1.536A10.04 10.04 0 0 0 12.04 22C17.607 22 22 17.527 22 11.96 22 6.395 17.607 2 12.04 2zm5.432 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/></svg>
              </a>
              <a href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Fvpinfra.co.in%2Fblog%2Fbest-house-builders-in-lucknow%2F" target="_blank" rel="noopener" class="share-btn share-fb" aria-label="Share on Facebook">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              </a>
              <a href="https://www.linkedin.com/shareArticle?mini=true&url=https%3A%2F%2Fvpinfra.co.in%2Fblog%2Fbest-house-builders-in-lucknow%2F" target="_blank" rel="noopener" class="share-btn share-li" aria-label="Share on LinkedIn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
              </a>
            </div>
          </div>

        </main>

        <!-- ── Sidebar ──────────────────────────────────────── -->
        <aside class="post-sidebar">

          <!-- Quick Links -->
          <div class="sidebar-card links-card">
            <div class="sidebar-card-header">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              Quick Links
            </div>
            <ul class="sidebar-links-list">
              <li>
                <a href="/services/building-construction-company-in-lucknow/" class="sidebar-link">
                  <span class="sidebar-link-icon">🏗️</span>
                  <span>Building Construction Services</span>
                  <svg class="sidebar-link-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
              </li>
              <li>
                <a href="/services/solar-installation/" class="sidebar-link">
                  <span class="sidebar-link-icon">☀️</span>
                  <span>Solar Installation Services</span>
                  <svg class="sidebar-link-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
              </li>
              <li>
                <a href="/about-us/" class="sidebar-link">
                  <span class="sidebar-link-icon">🏢</span>
                  <span>About VP Infra Properties</span>
                  <svg class="sidebar-link-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
              </li>
              <li>
                <a href="/contact-us/" class="sidebar-link">
                  <span class="sidebar-link-icon">📞</span>
                  <span>Get a Free Consultation</span>
                  <svg class="sidebar-link-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
              </li>
            </ul>
          </div>

          <!-- Related Posts -->
          <div class="sidebar-card related-card">
            <div class="sidebar-card-header">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
              Related Articles
            </div>
            <ul class="related-list">
              <li class="related-item">
                <a href="/blog/building-construction-trends-lucknow/" class="related-link">
                  <div class="related-img-wrap">
                    <img src="/images/building_construction.png" alt="Building Construction Trends Lucknow" class="related-img" loading="lazy" />
                  </div>
                  <div class="related-text">
                    <span class="related-tag">Construction</span>
                    <p class="related-title">Top Building Construction Trends in Lucknow for 2026</p>
                  </div>
                </a>
              </li>
              <li class="related-item">
                <a href="/blog/pm-surya-ghar-yojna-lucknow/" class="related-link">
                  <div class="related-img-wrap">
                    <img src="/images/pm_yogi_solar.jpg" alt="PM Surya Ghar Yojna Lucknow" class="related-img" loading="lazy" />
                  </div>
                  <div class="related-text">
                    <span class="related-tag">Solar Energy</span>
                    <p class="related-title">PM Surya Ghar Muft Bijli Yojna Guide for Lucknow</p>
                  </div>
                </a>
              </li>
              <li class="related-item">
                <a href="/blog/solar-energy-business-up-investment/" class="related-link">
                  <div class="related-img-wrap">
                    <img src="/images/solar_installation.png" alt="Solar Energy Business UP" class="related-img" loading="lazy" />
                  </div>
                  <div class="related-text">
                    <span class="related-tag">Commercial Solar</span>
                    <p class="related-title">Why Solar Energy is a Smart Investment for UP Businesses</p>
                  </div>
                </a>
              </li>
            </ul>
          </div>

          <!-- Sidebar CTA -->
          <div class="sidebar-cta">
            <div class="sidebar-cta-icon" aria-hidden="true">🏠</div>
            <p class="sidebar-cta-title">Planning to build?</p>
            <p class="sidebar-cta-text">Get a free site consultation from VP Infra's certified engineering team.</p>
            <a href="/contact-us/" class="btn btn-primary sidebar-cta-btn">Talk to Us</a>
            <a href="tel:+918840069902" class="sidebar-phone-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.3h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.9a16 16 0 0 0 6.29 6.29l.95-.86a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              +91 88400 69902
            </a>
          </div>

        </aside>
      </div>
    </div>
  </section>

</Layout>

<script>
  // ── Reading Progress Bar ──────────────────────────────────
  const bar = document.getElementById('readingProgress');
  const article = document.getElementById('articleContent');
  if (bar && article) {
    window.addEventListener('scroll', () => {
      const rect = article.getBoundingClientRect();
      const total = article.offsetHeight - window.innerHeight;
      const scrolled = -rect.top;
      const pct = Math.min(100, Math.max(0, (scrolled / total) * 100));
      bar.style.width = pct + '%';
    }, { passive: true });
  }


</script>

<style>
  /* ── Reading Progress Bar ─────────────────────────────── */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 0%;
    background: linear-gradient(90deg, var(--primary), #FFD700);
    z-index: 9999;
    transition: width 0.1s linear;
    border-radius: 0 2px 2px 0;
  }

  /* ── Post Header ──────────────────────────────────────── */
  .post-header {
    position: relative;
    background: linear-gradient(135deg, var(--secondary) 0%, #0d2137 60%, #1a3a5c 100%);
    color: var(--text-light);
    padding: 5rem 0 4rem;
    overflow: hidden;
    border-bottom: 3px solid var(--primary);
  }
  .post-header-bg {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 80% 20%, rgba(255,123,0,0.12) 0%, transparent 50%),
      radial-gradient(circle at 10% 80%, rgba(255,215,0,0.06) 0%, transparent 40%);
    pointer-events: none;
  }

  .breadcrumbs {
    font-size: 0.8rem;
    color: #64748B;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .breadcrumbs a { color: #64748B; transition: var(--transition); }
  .breadcrumbs a:hover { color: var(--primary); }
  .breadcrumb-sep { color: #334155; font-size: 0.9rem; }

  .post-header-inner { max-width: 800px; }

  .meta-tag-pill {
    display: inline-block;
    background: var(--primary);
    color: #fff;
    padding: 0.25rem 0.9rem;
    border-radius: 100px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .post-title {
    color: var(--text-light);
    font-size: clamp(1.6rem, 3.5vw, 2.5rem);
    line-height: 1.22;
    margin-bottom: 1.5rem;
    font-weight: 900;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: #64748B;
    flex-wrap: wrap;
  }
  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: #94A3B8;
  }
  .meta-dot { color: #334155; }

  /* ── Post Section ─────────────────────────────────────── */
  .post-section {
    background: #F1F5F9;
    padding: 3rem 0 6rem;
  }

  /* ── Two-column layout ────────────────────────────────── */
  .post-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2.5rem;
    align-items: start;
  }

  /* ── Main content column ──────────────────────────────── */
  .post-main {
    min-width: 0;
  }

  /* ── Hero Image ───────────────────────────────────────── */
  .post-hero-image-wrapper {
    position: relative;
    width: 100%;
    height: 440px;
    overflow: hidden;
    border-radius: 16px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.15);
    margin-bottom: 2.5rem;
  }
  .post-hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.4,0,0.2,1);
  }
  .post-hero-image-wrapper:hover .post-hero-image { transform: scale(1.04); }
  .hero-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10,25,47,0.35) 0%, transparent 60%);
    pointer-events: none;
    border-radius: 16px;
  }

  /* ── Article body card ────────────────────────────────── */
  .article-body {
    background: #fff;
    border-radius: 16px;
    padding: 2.75rem 2.75rem;
    box-shadow: 0 4px 24px rgba(0,0,0,0.06);
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.85;
    color: #374151;
  }

  /* Lead */
  .article-body :global(.lead) {
    font-size: 1.15rem;
    line-height: 1.78;
    color: var(--secondary);
    font-weight: 500;
    margin-bottom: 2rem;
    padding: 1.25rem 1.5rem;
    border-left: 4px solid var(--primary);
    background: linear-gradient(135deg, #FFF7ED 0%, #FFFBF5 100%);
    border-radius: 0 12px 12px 0;
  }

  /* H2 */
  .article-body :global(h2) {
    font-family: var(--font-heading);
    font-size: 1.55rem;
    font-weight: 900;
    color: var(--secondary);
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid #E2E8F0;
    scroll-margin-top: 90px;
  }
  .article-body :global(h2:first-child) { margin-top: 0; }

  /* H3 */
  .article-body :global(h3) {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--secondary);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    scroll-margin-top: 90px;
  }
  .article-body :global(h3)::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 1.1em;
    background: var(--primary);
    border-radius: 2px;
    flex-shrink: 0;
  }

  /* Paragraphs */
  .article-body :global(p) { margin-bottom: 1.5rem; }

  /* Lists */
  .article-body :global(ul),
  .article-body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.75rem;
  }
  .article-body :global(li) { margin-bottom: 0.6rem; }
  .article-body :global(ul li)::marker { color: var(--primary); }
  .article-body :global(ol li)::marker { color: var(--primary); font-weight: 700; }

  /* Strong */
  .article-body :global(strong) { color: var(--secondary); font-weight: 700; }

  /* ── Internal link style ──────────────────────────────── */
  .article-body :global(a:not(.btn)) {
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1.5px solid rgba(255,123,0,0.3);
    transition: border-color 0.2s, color 0.2s;
    padding-bottom: 1px;
  }
  .article-body :global(a:not(.btn):hover) {
    color: var(--primary-hover);
    border-bottom-color: var(--primary);
  }

  /* ── Table ────────────────────────────────────────────── */
  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0 2.5rem;
    font-size: 0.9375rem;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.07);
  }
  .article-body :global(thead) {
    background: linear-gradient(135deg, var(--secondary) 0%, #112240 100%);
  }
  .article-body :global(th) {
    color: #fff;
    padding: 1rem 1.125rem;
    text-align: left;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 700;
  }
  .article-body :global(td) {
    padding: 0.9rem 1.125rem;
    border-bottom: 1px solid #E2E8F0;
    color: #374151;
    vertical-align: top;
  }
  .article-body :global(td:first-child) { font-weight: 600; color: var(--secondary); }
  .article-body :global(td:last-child) {
    color: #16a34a;
    font-weight: 600;
  }
  .article-body :global(tr:nth-child(even) td) { background: #F8FAFC; }
  .article-body :global(tr:last-child td) { border-bottom: none; }
  .article-body :global(tr) { transition: background 0.15s; }
  .article-body :global(tr:hover td) { background: #FFF7ED; }

  /* ── Inline link card / note box ──────────────────────── */
  .article-body :global(.note-box) {
    background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
    border-left: 4px solid #F59E0B;
    padding: 1.25rem 1.5rem;
    border-radius: 0 12px 12px 0;
    margin: 2rem 0;
    font-size: 0.975rem;
    color: #78350F;
  }

  /* ── Internal link banner ─────────────────────────────── */
  .article-body :global(.internal-link-card) {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: linear-gradient(135deg, #F0F9FF 0%, #E0F2FE 100%);
    border: 1.5px solid #BAE6FD;
    border-radius: 12px;
    padding: 1.125rem 1.5rem;
    margin: 2rem 0;
    text-decoration: none !important;
    border-bottom: none !important;
    color: var(--secondary) !important;
    font-weight: 600;
    transition: var(--transition);
  }
  .article-body :global(.internal-link-card:hover) {
    background: linear-gradient(135deg, #E0F2FE 0%, #BAE6FD 100%);
    transform: translateX(4px);
    box-shadow: 0 4px 16px rgba(14,165,233,0.15);
  }
  .article-body :global(.internal-link-card .ilc-icon) {
    font-size: 1.5rem;
    flex-shrink: 0;
  }
  .article-body :global(.internal-link-card .ilc-label) {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #0EA5E9;
    font-weight: 700;
    display: block;
    margin-bottom: 0.15rem;
  }
  .article-body :global(.internal-link-card .ilc-title) {
    font-size: 0.975rem;
    font-weight: 700;
    color: var(--secondary);
  }
