---
import Layout from './Layout.astro';

interface Props {
  title: string;
  seoTitle: string;
  description: string;
  tag: string;
  date: string;
  readTime: string;
  author: string;
  image: string;
  imageAlt: string;
  breadcrumb: string;
}

const { title, seoTitle, description, tag, date, readTime, author, image, imageAlt, breadcrumb } = Astro.props;
---

<Layout title={seoTitle} description={description}>
  <!-- Breadcrumbs & Title Header -->
  <section class="post-header">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-sep">›</span>
        <a href="/blog/">Blog</a>
        <span class="breadcrumb-sep">›</span>
        <span>{breadcrumb}</span>
      </nav>
      <h1 class="post-title fade-in-up">{title}</h1>
      <div class="post-meta fade-in-up">
        <span class="meta-tag">{tag}</span>
        <span class="meta-dot">·</span>
        <span class="meta-item">📅 {date}</span>
        <span class="meta-dot">·</span>
        <span class="meta-item">⏱️ {readTime}</span>
        <span class="meta-dot">·</span>
        <span class="meta-item">✍️ {author}</span>
      </div>
    </div>
  </section>

  <!-- Article Body -->
  <section class="post-section">
    <div class="container">
      <div class="post-wrapper">

        <!-- Hero Image -->
        <div class="post-hero-image-wrapper">
          <img src={image} alt={imageAlt} class="post-hero-image" />
        </div>

        <!-- Article Content Slot -->
        <article class="article-body">
          <slot />
        </article>

        <!-- Back to Blog -->
        <div class="back-link-wrapper">
          <a href="/blog/" class="back-link">← Back to Blog</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ─── Header ──────────────────────────────────────────── */
  .post-header {
    background: linear-gradient(135deg, var(--secondary) 0%, var(--secondary-light) 100%);
    color: var(--text-light);
    padding: 5rem 0 4rem;
    border-bottom: 4px solid var(--primary);
  }

  .breadcrumbs {
    font-size: 0.875rem;
    color: #94A3B8;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }
  .breadcrumbs a {
    color: #94A3B8;
    transition: var(--transition);
  }
  .breadcrumbs a:hover { color: var(--primary); }
  .breadcrumb-sep { color: #475569; }

  .post-title {
    color: var(--text-light);
    font-size: clamp(1.75rem, 4vw, 2.6rem);
    line-height: 1.25;
    max-width: 820px;
    margin-bottom: 1.5rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.875rem;
    color: #94A3B8;
    flex-wrap: wrap;
  }
  .meta-tag {
    background-color: var(--primary);
    color: #fff;
    padding: 0.25rem 0.75rem;
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .meta-dot { color: #475569; }
  .meta-item { color: #94A3B8; }

  /* ─── Article Wrapper ─────────────────────────────────── */
  .post-section {
    background-color: #F8FAFC;
    padding: 3.5rem 0 6rem;
  }

  .post-wrapper {
    max-width: 780px;
    margin: 0 auto;
  }

  /* ─── Hero Image ──────────────────────────────────────── */
  .post-hero-image-wrapper {
    width: 100%;
    height: 420px;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: var(--shadow-lg);
    margin-bottom: 2.5rem;
  }
  .post-hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .post-hero-image-wrapper:hover .post-hero-image {
    transform: scale(1.02);
  }

  /* ─── Article Typography ──────────────────────────────── */
  .article-body {
    font-family: var(--font-body);
    font-size: 1.0625rem;       /* 17px — single base size */
    line-height: 1.85;
    color: #374151;
  }

  /* Lead paragraph */
  .article-body :global(.lead) {
    font-size: 1.2rem;
    line-height: 1.75;
    color: var(--secondary);
    font-weight: 500;
    margin-bottom: 2rem;
    padding-left: 1.25rem;
    border-left: 4px solid var(--primary);
  }

  /* Headings — strictly hierarchical */
  .article-body :global(h2) {
    font-family: var(--font-heading);
    font-size: 1.625rem;     /* 26px */
    font-weight: 700;
    color: var(--secondary);
    margin-top: 3rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--bg-gray);
  }
  .article-body :global(h3) {
    font-family: var(--font-heading);
    font-size: 1.25rem;      /* 20px */
    font-weight: 700;
    color: var(--secondary);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  /* Paragraphs */
  .article-body :global(p) {
    margin-bottom: 1.5rem;
  }

  /* Lists */
  .article-body :global(ul),
  .article-body :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.75rem;
  }
  .article-body :global(li) {
    margin-bottom: 0.6rem;
  }
  .article-body :global(ul li)::marker {
    color: var(--primary);
  }
  .article-body :global(ol li)::marker {
    color: var(--primary);
    font-weight: 700;
  }

  /* Strong */
  .article-body :global(strong) {
    color: var(--secondary);
    font-weight: 700;
  }

  /* ─── Table ───────────────────────────────────────────── */
  .article-body :global(.data-table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.95rem;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .article-body :global(.data-table th) {
    background-color: var(--secondary);
    color: #fff;
    padding: 0.875rem 1.125rem;
    text-align: left;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .article-body :global(.data-table td) {
    padding: 0.875rem 1.125rem;
    border-bottom: 1px solid #E2E8F0;
    color: #374151;
  }
  .article-body :global(.data-table tr:nth-child(even) td) {
    background-color: #F8FAFC;
  }
  .article-body :global(.data-table tr:last-child td) {
    border-bottom: none;
  }

  /* ─── Callout / Note Box ──────────────────────────────── */
  .article-body :global(.note-box) {
    background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
    border-left: 4px solid var(--accent);
    padding: 1.25rem 1.5rem;
    border-radius: 0 8px 8px 0;
    margin: 2rem 0;
    font-size: 0.975rem;
    color: #78350F;
  }

  /* ─── Steps List ──────────────────────────────────────── */
  .article-body :global(.steps-list) {
    list-style: none;
    padding-left: 0;
    counter-reset: steps;
    margin-bottom: 1.75rem;
  }
  .article-body :global(.steps-list li) {
    position: relative;
    padding: 1.25rem 1.25rem 1.25rem 4rem;
    margin-bottom: 1rem;
    background: #fff;
    border-radius: 8px;
    box-shadow: var(--shadow-sm);
    border: 1px solid #E2E8F0;
    counter-increment: steps;
  }
  .article-body :global(.steps-list li::before) {
    content: counter(steps);
    position: absolute;
    left: 1.125rem;
    top: 50%;
    transform: translateY(-50%);
    background: var(--primary);
    color: #fff;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.875rem;
  }

  /* ─── CTA Box ─────────────────────────────────────────── */
  .article-body :global(.cta-box) {
    background: linear-gradient(135deg, var(--secondary) 0%, var(--secondary-light) 100%);
    color: var(--text-light);
    padding: 2.5rem 2rem;
    border-radius: 12px;
    box-shadow: var(--shadow-lg);
    text-align: center;
    margin-top: 3rem;
  }
  .article-body :global(.cta-box h3) {
    color: var(--text-light);
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .article-body :global(.cta-box p) {
    color: #94A3B8;
    margin-bottom: 1.75rem;
    font-size: 1rem;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ─── Back Link ───────────────────────────────────────── */
  .back-link-wrapper {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #E2E8F0;
  }
  .back-link {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--primary);
    transition: var(--transition);
  }
  .back-link:hover {
    color: var(--primary-hover);
    padding-left: 4px;
  }

  /* ─── Responsive ──────────────────────────────────────── */
  @media (max-width: 640px) {
    .post-hero-image-wrapper { height: 240px; }
    .article-body :global(h2) { font-size: 1.375rem; }
    .article-body :global(h3) { font-size: 1.125rem; }
  }
</style>
