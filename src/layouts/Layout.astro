---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "V.P. Infra Properties (OPC) Private Limited - Construction and Solar Installation Services" } = Astro.props;

// Ensure consistent trailing slash for canonical URLs
const pathname = Astro.url.pathname.replace(/\/$/, '');
const canonicalPath = pathname === '' ? '/' : `${pathname}/`;
const canonicalURL = new URL(canonicalPath, Astro.site || 'https://www.vpinfra.co.in/');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{title} | V.P. Infra Properties</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Google Site Verification -->
		<meta name="google-site-verification" content="f1jo8gg5LkvCwOE4Y9baXN5AEttsF3waV-fE_JdYcUU" />

		<!-- Google Analytics -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-YS14DGWRY0"></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());

		  gtag('config', 'G-YS14DGWRY0');
		</script>

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={`${title} | V.P. Infra Properties`} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="V.P. Infra Properties (OPC) Private Limited" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={`${title} | V.P. Infra Properties`} />
		<meta property="twitter:description" content={description} />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Roboto:wght@700;900&display=swap" rel="stylesheet">
	
		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "ConstructionBusiness",
				"name": "V.P. Infra Properties (OPC) Private Limited",
				"url": "https://www.vpinfra.co.in/",
				"logo": "https://www.vpinfra.co.in/images/logo.jpg",
				"description": "Construction and Solar Installation Services in Lucknow.",
				"address": {
					"@type": "PostalAddress",
					"streetAddress": "M-652, Sector-M, Ashiyana Colony, Kanpur Road",
					"addressLocality": "Lucknow",
					"postalCode": "226012",
					"addressRegion": "UP",
					"addressCountry": "IN"
				},
				"telephone": "+91-8840069902"
			}
		</script>
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
