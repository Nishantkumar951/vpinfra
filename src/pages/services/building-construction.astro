---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Building Construction Services in UP"
  description="V.P. Infra Properties (OPC) Pvt Ltd. delivers residential and commercial building construction with modern engineering, robust materials, and ISO 9001:2015 quality standards."
>
  <!-- Page Header -->
  <section class="page-header text-center" style="background-image: linear-gradient(rgba(10, 25, 47, 0.8), rgba(10, 25, 47, 0.8)), url('/images/building_construction.png');">
    <div class="container">
      <h1 class="fade-in-up">Building Construction</h1>
      <p class="fade-in-up mt-4">Creating robust, modern, and aesthetic spaces for residential and commercial needs.</p>
    </div>
  </section>

  <!-- Service Details -->
  <section class="service-details">
    <div class="container">
      <div class="grid gap-8 service-grid">
        <div class="service-content fade-in-up">
          <h2 class="section-title" style="text-align: left; margin-bottom: 2rem;">Excellence in Every Brick</h2>
          <p class="mb-4">At V.P. Infra Properties (OPC) Pvt Ltd., building construction is our core expertise. We transform architectural visions into reality by employing modern construction techniques, rigorous quality control, and top-grade materials. Our ISO 9001:2015 certification reflects our uncompromising dedication to quality.</p>
          
          <h3 class="mt-8 mb-4">Our Construction Expertise</h3>
          <ul class="benefits-list">
            <li><strong>Residential Projects:</strong> Custom homes, apartments, and housing societies built for comfort and longevity.</li>
            <li><strong>Commercial Complexes:</strong> Office spaces, retail centers, and industrial facilities tailored for business efficiency.</li>
            <li><strong>Turnkey Solutions:</strong> Complete project management from foundation to final finishing and interior works.</li>
            <li><strong>Safety & Compliance:</strong> Strict adherence to structural safety standards and local building codes.</li>
          </ul>

          <div class="mt-8">
            <a href="/contact-us" class="btn btn-primary">Start Your Project</a>
          </div>
        </div>
        <div class="service-image fade-in-up" style="animation-delay: 0.2s;">
          <img src="/images/building_construction.png" alt="Building Construction" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background-size: cover;
    background-position: center;
    color: var(--text-light);
    padding: 8rem 0 6rem;
  }
  .page-header h1 {
    color: var(--text-light);
    font-size: 3.5rem;
  }
  .service-grid {
    grid-template-columns: 3fr 2fr;
    align-items: center;
  }
  @media (max-width: 992px) {
    .service-grid { grid-template-columns: 1fr; }
  }
  .service-image img {
    width: 100%;
    border-radius: 8px;
    box-shadow: var(--shadow-lg);
  }
  .benefits-list {
    list-style: none;
  }
  .benefits-list li {
    position: relative;
    padding-left: 2rem;
    margin-bottom: 1rem;
    color: var(--text-gray);
  }
  .benefits-list li::before {
    content: '🏗️';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--primary);
  }
  .benefits-list strong {
    color: var(--secondary);
  }
</style>
