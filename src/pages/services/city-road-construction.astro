---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="City Road Construction">
  <!-- Page Header -->
  <section class="page-header text-center" style="background-image: linear-gradient(rgba(10, 25, 47, 0.8), rgba(10, 25, 47, 0.8)), url('/images/road_construction.png');">
    <div class="container">
      <h1 class="fade-in-up">City Road Construction</h1>
      <p class="fade-in-up mt-4">Building the pathways to progress with durable and smooth road infrastructure.</p>
    </div>
  </section>

  <!-- Service Details -->
  <section class="service-details">
    <div class="container">
      <div class="grid gap-8 service-grid">
        <div class="service-content fade-in-up">
          <h2 class="section-title" style="text-align: left; margin-bottom: 2rem;">Connecting Communities</h2>
          <p class="mb-4">Infrastructure is the backbone of urban development. V.P. Infra Properties undertakes comprehensive city road construction projects, delivering smooth, durable, and weather-resistant pavements. We utilize advanced machinery and premium asphalt/concrete mixes to ensure longevity and minimal maintenance.</p>
          
          <h3 class="mt-8 mb-4">Highlights of Our Road Projects</h3>
          <ul class="benefits-list">
            <li><strong>Advanced Paving:</strong> Utilizing modern paving equipment for uniform surface finishes and proper grading.</li>
            <li><strong>Durable Materials:</strong> High-grade bitumen and concrete to withstand heavy traffic and extreme weather.</li>
            <li><strong>Timely Execution:</strong> Efficient project management to minimize disruption to public traffic and meet deadlines.</li>
            <li><strong>Safety First:</strong> Implementation of proper drainage, clear lane markings, and robust traffic safety measures during construction.</li>
          </ul>

          <div class="mt-8">
            <a href="/contact-us" class="btn btn-primary">Discuss Your Infrastructure Needs</a>
          </div>
        </div>
        <div class="service-image fade-in-up" style="animation-delay: 0.2s;">
          <img src="/images/road_construction.png" alt="City Road Construction" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background-size: cover;
    background-position: center;
    color: var(--text-light);
    padding: 8rem 0 6rem;
  }
  .page-header h1 {
    color: var(--text-light);
    font-size: 3.5rem;
  }
  .service-grid {
    grid-template-columns: 3fr 2fr;
    align-items: center;
  }
  @media (max-width: 992px) {
    .service-grid { grid-template-columns: 1fr; }
  }
  .service-image img {
    width: 100%;
    border-radius: 8px;
    box-shadow: var(--shadow-lg);
  }
  .benefits-list {
    list-style: none;
  }
  .benefits-list li {
    position: relative;
    padding-left: 2rem;
    margin-bottom: 1rem;
    color: var(--text-gray);
  }
  .benefits-list li::before {
    content: '🛣️';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--primary);
  }
  .benefits-list strong {
    color: var(--secondary);
  }
</style>
