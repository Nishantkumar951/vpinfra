<style>
  .page-header {
    background-size: cover;
    background-position: center;
    color: var(--text-light);
    padding: 8rem 0 6rem;
  }
  .page-header h1 {
    color: var(--text-light);
    font-size: 3.5rem;
  }
  .service-grid {
    grid-template-columns: 3fr 2fr;
    align-items: center;
  }
  @media (max-width: 992px) {
    .service-grid { grid-template-columns: 1fr; }
  }
  .service-image img {
    width: 100%;
    border-radius: 8px;
    box-shadow: var(--shadow-lg);
  }
  .benefits-list {
    list-style: none;
  }
  .benefits-list li {
    position: relative;
    padding-left: 2rem;
    margin-bottom: 1rem;
    color: var(--text-gray);
  }
  .benefits-list li::before {
    content: '🏗️';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--primary);
  }
  .benefits-list strong {
    color: var(--secondary);
  }

  .locations-section{background:var(--bg-gray)}
  .locations-section .loc-intro{max-width:800px;margin:0 auto 3rem;text-align:center;color:var(--text-gray)}
  .loc-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem}
  @media(max-width:992px){.loc-grid{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:700px){.loc-grid{grid-template-columns:repeat(2,1fr);gap:1rem}}
  @media(max-width:420px){.loc-grid{grid-template-columns:1fr}}
  .loc-card{display:flex;flex-direction:column;align-items:center;text-align:center;background:var(--bg-main);border-radius:8px;padding:1.75rem 1rem;box-shadow:var(--shadow-md);border-bottom:3px solid transparent;transition:var(--transition)}
  .loc-card:hover{transform:translateY(-8px);box-shadow:var(--shadow-hover);border-bottom-color:var(--primary)}
  .loc-icon{display:flex;align-items:center;justify-content:center;width:76px;height:76px;border-radius:50%;background:rgba(255,123,0,.1);color:var(--primary);margin-bottom:1rem;transition:var(--transition)}
  .loc-card:hover .loc-icon{background:var(--primary);color:var(--text-light)}
  .loc-name{font-family:var(--font-heading);font-weight:700;font-size:1.15rem;color:var(--secondary);line-height:1.25}
  .loc-sub{margin-top:.4rem;font-size:.85rem;color:var(--text-gray)}
</style>
