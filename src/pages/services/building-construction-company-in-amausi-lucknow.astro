.build-grid .card-title{border-top:3px solid var(--primary);padding-top:1rem}
.build-grid .card-text{margin-bottom:0}
.loc-text{max-width:900px;margin:0 auto}
.faq-list{max-width:900px;margin:0 auto;display:grid;gap:1.25rem}
.faq-item{background:var(--bg-main);border-radius:8px;box-shadow:var(--shadow-sm);padding:1.5rem 1.75rem;border-left:4px solid var(--primary)}
.faq-item h3{font-size:1.15rem;margin-bottom:.6rem}
.faq-item p{color:var(--text-gray);text-align:justify}
.cta-banner{background:var(--secondary);color:var(--text-light);text-align:center;padding:4rem 0}
.cta-banner h2{color:var(--text-light);font-size:2.2rem;margin-bottom:1rem}
.cta-banner p{color:#cbd5e1;max-width:700px;margin:0 auto 1.75rem}
.cta-banner .phone{margin-top:1.25rem;color:var(--accent);font-weight:600}
.area-links{display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center;margin-top:1.5rem}
.area-links a{padding:.5rem 1rem;border:1px solid var(--bg-gray);background:var(--bg-main);border-radius:999px;font-size:.9rem;font-weight:500;color:var(--secondary);box-shadow:var(--shadow-sm)}
.area-links a:hover{border-color:var(--primary);color:var(--primary)}
