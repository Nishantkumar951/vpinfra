---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contact Us | V.P. Infra Properties Lucknow"
  description="Get in touch with V.P. Infra Properties for building construction and solar panel installations in Uttar Pradesh."
>
  <!-- Page Header -->
  <section class="page-header text-center">
    <div class="container">
      <h1 class="fade-in-up">Contact Us</h1>
      <p class="fade-in-up mt-4">We are here to answer any questions you may have about our services.</p>
    </div>
  </section>

  <!-- Contact Content -->
  <section class="contact-section">
    <div class="container">
      <div class="contact-grid grid gap-8">
        
        <!-- Contact Info -->
        <div class="contact-info fade-in-up">
          <h2 class="section-title" style="text-align: left; margin-bottom: 2rem;">Get In Touch</h2>
          <p class="mb-8 text-gray">Feel free to reach out to us for project inquiries, solar installations, or any construction needs.</p>
          
          <div class="info-card">
            <div class="info-icon">📍</div>
            <div>
              <h4>Registered Address</h4>
              <p>M-652, Sector-M, Ashiyana Colony, Kanpur Road, Lucknow, UP - 226012</p>
            </div>
          </div>
          
          <div class="info-card mt-4">
            <div class="info-icon">📞</div>
            <div>
              <h4>Mobile Number</h4>
              <p>8840069902</p>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="contact-form-wrapper fade-in-up" style="animation-delay: 0.2s;">
          <form class="contact-form" action="https://formsubmit.co/virendramishra843@gmail.com" method="POST">
            <!-- FormSubmit Configuration -->
            <input type="hidden" name="_subject" value="New Enquiry from V.P. Infra Website!">
            <input type="hidden" name="_template" value="table">
            <input type="hidden" name="_captcha" value="false">
            <input type="hidden" name="_next" value="https://www.vpinfra.co.in/contact-us">

            <div class="form-group">
              <label for="name">Full Name</label>
              <input type="text" id="name" name="name" placeholder="Enter your full name" required />
            </div>
            <div class="form-group">
              <label for="email">Email Address</label>
              <input type="email" id="email" name="email" placeholder="Enter your email" required />
            </div>
            <div class="form-group">
              <label for="service">Service Interested In</label>
              <select id="service" name="service" required>
                <option value="" disabled selected>Select a service</option>
                <option value="Solar Installation">Solar Installation</option>
                <option value="Building Construction">Building Construction</option>
                <option value="Other Inquiry">Other Inquiry</option>
              </select>
            </div>
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="5" placeholder="Tell us about your project" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary w-100">Send Message</button>
            
            <!-- Success Message Container -->
            <div id="success-message" style="display: none; margin-top: 1.5rem; padding: 1rem; background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; border-radius: 4px; text-align: center; font-weight: 500;">
              Thank you! Your message has been submitted successfully. We will get back to you soon.
            </div>
          </form>
        </div>

      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.querySelector('.contact-form') as HTMLFormElement;
  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const originalText = btn.textContent || 'Send Message';
      const successMsg = document.getElementById('success-message');
      
      btn.textContent = 'Sending...';
      btn.disabled = true;

      const formData = new FormData(form);

      fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: {
          'Accept': 'application/json'
        }
      })
      .then(response => {
        if (response.ok) {
          if (successMsg) successMsg.style.display = 'block';
          form.reset();
          setTimeout(() => {
            if (successMsg) successMsg.style.display = 'none';
          }, 5000);
        } else {
          alert('Oops! There was a problem submitting your form. Please try again.');
        }
      })
      .catch(error => {
        alert('Oops! There was a problem submitting your form. Please check your connection.');
      })
      .finally(() => {
        btn.textContent = originalText;
        btn.disabled = false;
      });
    });
  }
</script>

<style>
  .page-header {
    background-color: var(--secondary);
    color: var(--text-light);
    padding: 6rem 0 4rem;
  }
  .page-header h1 {
    color: var(--text-light);
    font-size: 3rem;
  }
  .contact-grid {
    grid-template-columns: 1fr 1fr;
  }
  @media (max-width: 768px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
  
  .info-card {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    padding: 1.5rem;
    background: var(--bg-main);
    border-radius: 8px;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--bg-gray);
    transition: var(--transition);
  }
  .info-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .info-icon {
    font-size: 1.5rem;
    background: rgba(255, 123, 0, 0.1);
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }
  .info-card h4 {
    margin-bottom: 0.5rem;
    color: var(--secondary);
  }
  .info-card p {
    color: var(--text-gray);
    margin: 0;
  }

  .contact-form-wrapper {
    background: var(--bg-main);
    padding: 2.5rem;
    border-radius: 8px;
    box-shadow: var(--shadow-lg);
  }
  .form-group {
    margin-bottom: 1.5rem;
  }
  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
    color: var(--secondary);
  }
  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 0.8rem 1rem;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    font-family: inherit;
    font-size: 1rem;
    transition: var(--transition);
  }
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(255, 123, 0, 0.1);
  }
  .w-100 {
    width: 100%;
  }
</style>
