---
import Layout from '../../layouts/Layout.astro';

// Fetch all markdown files in the blog directory using Vite's import.meta.glob
const posts = Object.values(import.meta.glob('./*.md', { eager: true }));
// Sort posts by date descending
const sortedPosts = posts.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
---

<Layout 
  title="Our Blog | Construction & Solar Insights"
  description="Read the latest news, insights, and expert advice on building construction, road development, and solar panel installations from V.P. Infra Properties."
>
  <section class="page-header text-center">
    <div class="container">
      <h1 class="fade-in-up">Our Blog</h1>
      <p class="fade-in-up mt-4">Insights, updates, and expert advice on construction and solar energy.</p>
    </div>
  </section>

  <section class="blog-listing bg-gray">
    <div class="container">
      <div class="blog-grid grid gap-8 mt-8">
        {sortedPosts.map(post => (
          <div class="card fade-in-up">
            {post.frontmatter.image && (
              <div class="card-img-wrapper">
                <img src={post.frontmatter.image} alt={post.frontmatter.title} class="card-img" />
              </div>
            )}
            <div class="card-content">
              <span class="blog-date">{new Date(post.frontmatter.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
              <h3 class="card-title" style="margin-top: 0.5rem;"><a href={post.url}>{post.frontmatter.title}</a></h3>
              <p class="card-text">{post.frontmatter.excerpt}</p>
              <a href={post.url} class="btn btn-outline" style="padding: 0.5rem 1rem;">Read Article</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background-color: var(--secondary);
    color: var(--text-light);
    padding: 6rem 0 4rem;
  }
  .page-header h1 {
    color: var(--text-light);
    font-size: 3rem;
  }
  .blog-grid {
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
  }
  .blog-date {
    font-size: 0.85rem;
    color: var(--primary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .card-title a {
    color: inherit;
    text-decoration: none;
    transition: var(--transition);
  }
  .card-title a:hover {
    color: var(--primary);
  }
</style>
